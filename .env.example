# ── Required ──────────────────────────────────────────────────────────────
# Get these from: GitHub → Settings → Developer settings → OAuth Apps → Your App

GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# ── Optional ──────────────────────────────────────────────────────────────

# Scopes to request (space-separated). Defaults to "read:user user:email".
# Full list: https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/scopes-for-oauth-apps
#
# GITHUB_SCOPES=read:user user:email repo read:org

# Client-side authorization code expiry guard (seconds).
# GitHub hard-expires codes at 600 s (10 min) — this cannot be changed.
# Set lower to add a stricter local check, e.g. 30 s for demo purposes.
#
# CODE_MAX_AGE_SECONDS=600

# Set to "true" to construct a simulated OIDC ID Token from the /user
# response after auth. Clearly labelled as simulated — not cryptographically
# valid. Illustrates what a real OIDC ID Token would look like.
# Note: GitHub OAuth Apps do NOT issue real ID Tokens.
#
# SIMULATE_ID_TOKEN=false
